{
  "datasets": [
    {
      "name": "cb98735a",
      "displayName": "Datos sin nombre",
      "queryLines": [
        "SELECT\r\n",
        "    product_name AS producto,\r\n",
        "    total_compras,\r\n",
        "    tasa_recompra\r\n",
        "FROM dbw_supermarket_prod.gold.productos_populares\r\n",
        "ORDER BY total_compras DESC\r\n",
        "LIMIT 10;\r\n"
      ]
    },
    {
      "name": "b79ceb57",
      "displayName": "Compras por departamento",
      "queryLines": [
        "SELECT\r\n",
        "    department AS departamento,\r\n",
        "    total_productos_comprados AS total_compras,\r\n",
        "    tasa_recompra\r\n",
        "FROM dbw_supermarket_prod.gold.departamentos\r\n",
        "ORDER BY total_productos_comprados DESC;\r\n"
      ]
    },
    {
      "name": "f05ee672",
      "displayName": "Pedidos por hora",
      "queryLines": [
        "SELECT\r\n",
        "    order_hour_of_day AS hora,\r\n",
        "    total_pedidos,\r\n",
        "    promedio_articulos_pedido\r\n",
        "FROM dbw_supermarket_prod.gold.pedidos_por_hora\r\n",
        "ORDER BY hora;\r\n"
      ]
    }
  ],
